# Nuxt public runtime config (client side, safe to expose — anon key is public)
# Values are injected at build time via NUXT_PUBLIC_* env vars.
NUXT_PUBLIC_SUPABASE_URL=https://eghddkeceomhwkaefqrq.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key

# These same Supabase credentials power posts, newsletters and site updates
# across all environments (local dev, staging, production).

# --- Mock mode (client-side only, no Supabase) ---
# Set NUXT_PUBLIC_MOCK=1 to run `pnpm dev:mock` without Supabase:
#   - fake manager login (no Google redirect)
#   - in-memory calendar with sample December 2026 data
# Example: NUXT_PUBLIC_MOCK=1 pnpm dev
